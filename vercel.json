{
  "buildCommand": "cd apps/host && pnpm install && pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": "nextjs",
  "outputDirectory": "apps/host/.next",
  "regions": ["iad1"],
  "functions": {
    "apps/host/src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
