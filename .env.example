# Epic Tech AI Digital Backpack - Environment Variables
# Copy this file to .env.local and fill in your actual API keys

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=production

# ============================================
# AI PROVIDERS
# ============================================

# OpenAI API Key (for Chat Nexus and AI features)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (alternative AI provider)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Replicate API Key (for Music Vault and AI models)
# Get your key from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your-replicate-token-here

# ============================================
# DATABASE & STORAGE
# ============================================

# Supabase Configuration (for persistent storage)
# Get your credentials from: https://app.supabase.com/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# VERSION CONTROL
# ============================================

# GitHub Personal Access Token (for Code Vault)
# Create token at: https://github.com/settings/tokens
# Required scopes: repo, workflow
GITHUB_TOKEN=ghp_your-github-personal-access-token

# ============================================
# OPTIONAL INTEGRATIONS
# ============================================

# Vercel Analytics (optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-analytics-id

# Sentry Error Tracking (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================
# SECURITY
# ============================================

# NextAuth Secret (for authentication)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ============================================
# FEATURE FLAGS
# ============================================

# Enable/disable features
NEXT_PUBLIC_ENABLE_MUSIC_VAULT=true
NEXT_PUBLIC_ENABLE_CODE_VAULT=true
NEXT_PUBLIC_ENABLE_GAME_LABS=true
NEXT_PUBLIC_ENABLE_CHAT_NEXUS=true
